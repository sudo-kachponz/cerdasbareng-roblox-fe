generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -- CerdasBareng existing tables (stubs — adapt to real CB schema) --

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole @default(STUDENT)
  createdAt DateTime @default(now()) @map("created_at")

  tutorRobloxAccount TutorRobloxAccount?
  robloxSessions     RobloxSession[]
  enrollments        Enrollment[]

  @@map("users")
}

enum UserRole {
  TUTOR
  STUDENT
  ADMIN
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  sessionId String           @map("session_id")
  status    EnrollmentStatus @default(UNPAID)
  createdAt DateTime         @default(now()) @map("created_at")

  user    User          @relation(fields: [userId], references: [id])
  session RobloxSession @relation(fields: [sessionId], references: [id])

  @@unique([userId, sessionId])
  @@map("enrollments")
}

enum EnrollmentStatus {
  PAID
  UNPAID
}

// -- Roblox integration tables --

model TutorRobloxAccount {
  id               String   @id @default(cuid())
  tutorId          String   @unique @map("tutor_id")
  robloxUserId     String   @unique @map("roblox_user_id")
  username         String
  displayName      String   @map("display_name")
  avatarUrl        String?  @map("avatar_url")
  accessTokenEnc   String   @map("access_token_enc")
  refreshTokenEnc  String   @map("refresh_token_enc")
  tokenExpiresAt   DateTime @map("token_expires_at")
  linkedAt         DateTime @default(now()) @map("linked_at")

  tutor User @relation(fields: [tutorId], references: [id])

  @@map("tutor_roblox_accounts")
}

model RobloxSession {
  id          String        @id @default(cuid())
  code        String        @unique // CB-XXXX
  tutorId     String        @map("tutor_id")
  title       String
  subject     String
  gradeLevel  String        @map("grade_level") // SD, SMP, SMA
  world       String
  startAt     DateTime      @map("start_at")
  durationMin Int           @map("duration_min")
  capacity    Int
  status      SessionStatus @default(SCHEDULED)
  accessCode  String?       @map("access_code") // reserved server access code from Roblox
  failReason  String?       @map("fail_reason")
  placeId     String?       @map("place_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tutor       User              @relation(fields: [tutorId], references: [id])
  joinTokens  RobloxJoinToken[]
  enrollments Enrollment[]

  @@map("roblox_sessions")
}

enum SessionStatus {
  SCHEDULED
  PROVISIONING
  READY
  LIVE
  ENDED
  FAILED
  CANCELLED
}

model RobloxJoinToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @map("token_hash") // sha256 of the raw token
  sessionId  String    @map("session_id")
  userId     String    @map("user_id")
  role       String    // "tutor" | "student"
  expiresAt  DateTime  @map("expires_at")
  redeemedAt DateTime? @map("redeemed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  session RobloxSession @relation(fields: [sessionId], references: [id])

  @@map("roblox_join_tokens")
}
