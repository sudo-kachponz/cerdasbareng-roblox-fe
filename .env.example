# Mode mock: API route memakai data dummy in-memory (tanpa Roblox asli)
NEXT_PUBLIC_USE_MOCK=true

# --- Database ---
DATABASE_URL=postgresql://user:pass@localhost:5432/cerdasbareng

# --- Redis (untuk BullMQ job queue) ---
REDIS_URL=redis://localhost:6379

# --- Roblox OAuth 2.0 ---
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
ROBLOX_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/roblox/oauth/callback

# --- Encryption key for Roblox tokens at rest (32 bytes = 64 hex chars) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROBLOX_TOKEN_ENCRYPTION_KEY=

# --- Experience / Place ---
NEXT_PUBLIC_ROBLOX_LOBBY_PLACE_ID=
# API key yang dipakai server Roblox (HttpService) saat memanggil backend CB
ROBLOX_GAME_SERVER_API_KEY=
